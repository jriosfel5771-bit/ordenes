  "item": [
    {
      "name": "1. Consultas",
      "item": [
        {
          "name": "Dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Sin errores GraphQL', () => pm.expect(pm.response.json().errors).to.be.undefined);",
                  "pm.test('Incluye los 4 estados', () => pm.expect(pm.response.json().data.orderStats.byStatus).to.have.lengthOf(4));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetOrderStats {\n  orderStats {\n    total\n    byStatus {\n      status\n      count\n    }\n  }\n}",
                "variables": "{}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Total de órdenes y conteo por estado (pantalla Dashboard)."
          },
          "response": []
        },
        {
          "name": "Listar ordenes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Sin errores GraphQL', () => pm.expect(pm.response.json().errors).to.be.undefined);",
                  "pm.test('Devuelve una lista', () => pm.expect(pm.response.json().data.orders).to.be.an('array'));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetOrders {\n  orders {\n    ...OrderFields\n  }\n}\n\nfragment OrderFields on Order {\n  id\n  customerStore\n  originCountry\n  destinationCity\n  bouquetQuantity\n  status\n}",
                "variables": "{}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Listado completo, más recientes primero."
          },
          "response": []
        },
        {
          "name": "Filtrar por estado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Sin errores GraphQL', () => pm.expect(pm.response.json().errors).to.be.undefined);",
                  "",
                  "pm.test('Todas en IN_TRANSIT', () => pm.response.json().data.orders.forEach(o => pm.expect(o.status).to.eql('IN_TRANSIT')));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetOrders($status: OrderStatus) {\n  orders(status: $status) {\n    ...OrderFields\n  }\n}\n\nfragment OrderFields on Order {\n  id\n  customerStore\n  originCountry\n  destinationCity\n  bouquetQuantity\n  status\n  createdAt\n}",
                "variables": "{\n  \"status\": \"CANCELLED\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Cambia la variable status: CREATED, IN_TRANSIT, DELIVERED o CANCELLED."
          },
          "response": []
        }
      ],
      "description": "Dashboard y consulta de ordenes"
    },
    {
      "name": "2. Flujo de una orden",
      "item": [
        {
          "name": "Crear orden",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Sin errores GraphQL', () => pm.expect(pm.response.json().errors).to.be.undefined);",
                  "",
                  "pm.test('Estado = CREATED', () => pm.expect(pm.response.json().data.createOrder.status).to.eql('CREATED'));",
                  "",
                  "const id = pm.response.json().data.createOrder.id;",
                  "pm.collectionVariables.set('orderId', id);",
                  "console.log('orderId =', id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateOrder($input: CreateOrderInput!) {\n  createOrder(input: $input) {\n    ...OrderFields\n  }\n}\n\nfragment OrderFields on Order {\n  id\n  customerStore\n  originCountry\n  destinationCity\n  bouquetQuantity\n  status\n  createdAt\n}",
                "variables": "{\n  \"input\": {\n    \"customerStore\": \"Market Miami 2\",\n    \"originCountry\": \"Colombia\",\n    \"destinationCity\": \"Miami\",\n    \"bouquetQuantity\": 85\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Crea una orden y guarda su id en la variable de colección orderId."
          },
          "response": []
        },
        {
          "name": "Detalle por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Sin errores GraphQL', () => pm.expect(pm.response.json().errors).to.be.undefined);",
                  "",
                  "pm.test('Es la orden creada', () => pm.expect(pm.response.json().data.order.id).to.eql(pm.collectionVariables.get('orderId')));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetOrder($id: UUID!) {\n  order(id: $id) {\n    ...OrderFields\n  }\n}\n\nfragment OrderFields on Order {\n  id\n  customerStore\n  originCountry\n  destinationCity\n  bouquetQuantity\n  status\n  createdAt\n}",
                "variables": "{\n  \"id\": \"{{orderId}}\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Usa el orderId guardado por 'Crear orden'."
          },
          "response": []
        },
        {
          "name": "Cambiar a IN_TRANSIT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Sin errores GraphQL', () => pm.expect(pm.response.json().errors).to.be.undefined);",
                  "",
                  "pm.test('Estado = IN_TRANSIT', () => pm.expect(pm.response.json().data.updateOrderStatus.status).to.eql('IN_TRANSIT'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateOrderStatus($id: UUID!, $status: OrderStatus!) {\n  updateOrderStatus(id: $id, status: $status) {\n    id\n    status\n  }\n}",
                "variables": "{\n  \"id\": \"{{orderId}}\",\n  \"status\": \"IN_TRANSIT\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Transición permitida: CREATED → IN_TRANSIT."
          },
          "response": []
        },
        {
          "name": "Cambiar a DELIVERED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Sin errores GraphQL', () => pm.expect(pm.response.json().errors).to.be.undefined);",
                  "",
                  "pm.test('Estado = DELIVERED', () => pm.expect(pm.response.json().data.updateOrderStatus.status).to.eql('DELIVERED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateOrderStatus($id: UUID!, $status: OrderStatus!) {\n  updateOrderStatus(id: $id, status: $status) {\n    id\n    status\n  }\n}",
                "variables": "{\n  \"id\": \"{{orderId}}\",\n  \"status\": \"DELIVERED\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Transición permitida: IN_TRANSIT → DELIVERED."
          },
          "response": []
        }
      ],
      "description": "Ejecuta estas peticiones en orden . 'Crear orden' guarda el id en la variable orderId."
    },
    {
      "name": "3. Validaciones y errores",
      "item": [
        {
          "name": "Transición inválida (DELIVERED → CREATED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Devuelve un error GraphQL', () => pm.expect(json.errors).to.be.an('array').that.is.not.empty);",
                  "pm.test('El mensaje explica el problema', () => pm.expect(json.errors[0].message).to.include('no permitida'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateOrderStatus($id: UUID!, $status: OrderStatus!) {\n  updateOrderStatus(id: $id, status: $status) {\n    id\n    status\n  }\n}",
                "variables": "{\n  \"id\": \"{{orderId}}\",\n  \"status\": \"CREATED\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Debe fallar: la regla de negocio solo permite CREATED→IN_TRANSIT, IN_TRANSIT→DELIVERED y CREATED→CANCELLED. Ejecuta antes el flujo 2."
          },
          "response": []
        },
        {
          "name": "Crear con cantidad 0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Devuelve un error GraphQL', () => pm.expect(json.errors).to.be.an('array').that.is.not.empty);",
                  "pm.test('El mensaje explica el problema', () => pm.expect(json.errors[0].message).to.include('mayor a 0'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateOrder($input: CreateOrderInput!) {\n  createOrder(input: $input) {\n    id\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"customerStore\": \"Tienda prueba\",\n    \"originCountry\": \"Ecuador\",\n    \"destinationCity\": \"Houston\",\n    \"bouquetQuantity\": 0\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Debe fallar: la cantidad de ramos debe ser mayor a 0."
          },
          "response": []
        },
        {
          "name": "Orden inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Devuelve un error GraphQL', () => pm.expect(json.errors).to.be.an('array').that.is.not.empty);",
                  "pm.test('El mensaje explica el problema', () => pm.expect(json.errors[0].message).to.include('no existe'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
