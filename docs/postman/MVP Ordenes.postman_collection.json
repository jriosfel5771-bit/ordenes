            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateOrderStatus($id: UUID!, $status: OrderStatus!) {\n  updateOrderStatus(id: $id, status: $status) {\n    id\n    status\n  }\n}",
                "variables": "{\n  \"id\": \"00000000-0000-0000-0000-000000000000\",\n  \"status\": \"IN_TRANSIT\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "description": "Debe fallar con 'no existe'."
          },
          "response": []
        }
      ]
